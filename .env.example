# 复制本文件为 .env，填入你自己的值；.env 已被 .gitignore 忽略，永不上传
# 换服务商只需改这里的 3 行：任何 OpenAI 兼容接口都行

LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-在这里填你的key
LLM_MODEL=deepseek-flash

# 单价（美元 / 百万 token），用于估算成本；填 0 表示只统计 token
PRICE_IN=0.15
PRICE_OUT=0.6
CURRENCY=USD

# 向量化（知识库检索用）
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_API_KEY=sk-在这里填你的百炼key
EMBED_MODEL=text-embedding-v3

# 可选：检索开关（默认都开）
ENABLE_RERANK=1
ENABLE_REWRITE=1

# 可选：数据路径（容器里建议放可写目录，或挂载卷）
# ASSISTANT_DB=/data/assistant.db
# AGENT_WORKSPACE=/data/agent_workspace
# KB_DIR=/data/kbs


# 公开部署建议开启：访问口令 + 每 IP 每分钟限流
# ACCESS_TOKEN=换成你的口令
# RATE_LIMIT_PER_MIN=20

# 可选：联网搜索（不配则用 DuckDuckGo / Bing）
TAVILY_API_KEY=

# 可选：告警推送（飞书/钉钉/通用 JSON）
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TYPE=auto

# 可选：免打扰时段（跨天用 22:00-08:00）
ALERT_QUIET_START=
ALERT_QUIET_END=

# 可选：收盘综述推送（默认 16 点，工作日）
BRIEF_PUSH_HOUR=16
ENABLE_DAILY_BRIEF=1

# 登录 token 签名密钥（不填则用 ACCESS_TOKEN 或开发默认值）
AUTH_SECRET=

# 内置管理员（密码不填则用 ACCESS_TOKEN）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
