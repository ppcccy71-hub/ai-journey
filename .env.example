# 复制本文件为 .env，填入你自己的值；.env 已被 .gitignore 忽略，永不上传
# 换服务商只需改这里的 3 行：任何 OpenAI 兼容接口都行

LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-在这里填你的key
LLM_MODEL=deepseek-flash

# 可选：单价（美元 / 百万 token），用于估算成本；不知道就去官网定价页查，填 0 表示只统计 token
# deepseek-flash 非高峰：输入(cache miss) 0.15，输出 0.6；高峰翻倍
PRICE_IN=0.15
PRICE_OUT=0.6
CURRENCY=USD
